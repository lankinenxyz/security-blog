# Production origin, no trailing slash. Feeds metadataBase, canonical URLs,
# the sitemap, robots.txt and the RSS feed. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Notion content source (required) ---
# Posts are read from a Notion database. Set NOTION_TOKEN and a database (or
# data source) id.
#
# Create an internal integration at https://www.notion.so/my-integrations,
# share the database with it, and copy the secret here.
NOTION_TOKEN=

# The database id from its URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# Optional: target a specific data source in the database. Leave empty to use
# the database's first data source automatically.
NOTION_DATA_SOURCE_ID=
